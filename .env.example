# Supabase connection (Vercel → Project → Settings → Environment Variables).
# Use the Project URL and the *publishable* key from Supabase → Project Settings → API Keys.
# Never put the secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
